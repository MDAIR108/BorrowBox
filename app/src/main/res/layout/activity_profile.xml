<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:paddingBottom="130dp">

            <!-- Top Toolbar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="12dp">

                <!-- Back button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_border"
                    app:cardBackgroundColor="@color/card_bg"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="←"
                        android:textColor="@color/peach_accent"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textColor="@color/light_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- Edit Button in Top Corner -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditToolbar"
                    style="@style/Widget.BorrowBox.Button.Peach"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Edit"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_text"
                    app:backgroundTint="@color/peach_accent"
                    app:cornerRadius="18dp"
                    android:paddingHorizontal="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:indeterminateTint="@color/peach_accent" />

            <!-- Profile Header Card (Photo on top, Name and Roll below it) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfileHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="20dp">

                    <!-- Circular Avatar with peach ring + camera badge -->
                    <FrameLayout
                        android:layout_width="104dp"
                        android:layout_height="104dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/avatarContainer"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_gravity="center"
                            app:cardCornerRadius="48dp"
                            app:cardElevation="2dp"
                            app:strokeWidth="2.5dp"
                            app:strokeColor="@color/peach_ring"
                            app:cardBackgroundColor="@color/input_bg_dark">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:id="@+id/ivProfilePicture"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:contentDescription="Profile Photo"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/tvProfileInitial"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@color/peach_accent"
                                    android:gravity="center"
                                    android:text="U"
                                    android:textColor="@color/dark_text"
                                    android:textSize="36sp"
                                    android:textStyle="bold" />

                                <ProgressBar
                                    android:id="@+id/pbPhotoUploading"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_gravity="center"
                                    android:visibility="gone"
                                    android:indeterminateTint="@color/peach_accent" />
                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnChangePhoto"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="bottom|end"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="17dp"
                            app:cardElevation="4dp"
                            app:strokeWidth="1.5dp"
                            app:strokeColor="@color/card_bg"
                            app:cardBackgroundColor="@color/peach_accent">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_camera"
                                android:contentDescription="Change Profile Photo"
                                app:tint="@color/dark_text" />
                        </com.google.android.material.card.MaterialCardView>

                    </FrameLayout>

                    <!-- Student Full Name -->
                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Tanvir Ahmed"
                        android:textColor="@color/light_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Student Roll Number (Prominent Pill directly under Name) -->
                    <TextView
                        android:id="@+id/tvRoll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_search_pill"
                        android:backgroundTint="@color/input_bg_dark"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/peach_accent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Roll: 1907001" />

                    <!-- Edit Profile Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditProfileHeader"
                        style="@style/Widget.BorrowBox.Button.Peach"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="12dp"
                        android:text="Edit Profile"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="@color/peach_accent"
                        app:cornerRadius="18dp"
                        android:paddingHorizontal="20dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= Group 1: Personal Info ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="Personal Info"
                android:textColor="@color/peach_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Email -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Institutional Email"
                        android:textColor="@color/light_text_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/light_text_primary"
                        android:textSize="14sp"
                        tools:text="student@ugrad.kuet.ac.bd" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/divider_color" />

                    <!-- Phone Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Number"
                        android:textColor="@color/light_text_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/light_text_primary"
                        android:textSize="14sp"
                        tools:text="+8801712345678" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/divider_color" />

                    <!-- WhatsApp Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WhatsApp Number"
                        android:textColor="@color/light_text_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvWhatsApp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/peach_accent"
                        android:textSize="14sp"
                        tools:text="+8801712345678" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/divider_color" />

                    <!-- Department -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Department"
                        android:textColor="@color/light_text_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvProfileDept"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/light_text_primary"
                        android:textSize="14sp"
                        tools:text="Computer Science &amp; Engineering" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/divider_color" />

                    <!-- Campus Address / Hall -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Campus Address / Hall"
                        android:textColor="@color/light_text_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/light_text_primary"
                        android:textSize="14sp"
                        tools:text="Amar Ekushey Hall, KUET" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= Group 2: Account ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="Account"
                android:textColor="@color/peach_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Verification status pill -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Student Verification Status"
                        android:textColor="@color/light_text_muted"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/tvVerificationBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_available"
                            android:text="KUET Verified Student"
                            android:textColor="@color/dark_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="5dp" />

                        <TextView
                            android:id="@+id/tvTrustScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="★ 5.0 Trust Score"
                            android:textColor="@color/peach_accent"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Campus CR / Member Info -->
                    <TextView
                        android:id="@+id/tvCR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Campus Member"
                        android:textColor="@color/light_text_secondary"
                        android:textSize="12sp" />

                    <!-- Divider before Email OTP section -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/divider_color" />

                    <!-- Email OTP Verification Sub-Card / Section -->
                    <TextView
                        android:id="@+id/tvOtpSectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Institutional Email Verification"
                        android:textColor="@color/peach_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardOtpSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/card_border"
                        app:cardBackgroundColor="@color/input_bg_dark">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tvOtpSectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Verify Institutional Email"
                                android:textColor="@color/light_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvOtpSectionSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Submit 6-digit OTP sent to your email to activate student privileges."
                                android:textColor="@color/light_text_secondary"
                                android:textSize="11sp" />

                            <!-- Send / Resend OTP Action Row -->
                            <LinearLayout
                                android:id="@+id/layoutSendOtp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="10dp">

                                <TextView
                                    android:id="@+id/tvOtpEmailNotice"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Need a verification code?"
                                    android:textColor="@color/light_text_muted"
                                    android:textSize="11sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSendOtp"
                                    style="@style/Widget.BorrowBox.Button.Peach"
                                    android:layout_width="wrap_content"
                                    android:layout_height="34dp"
                                    android:minHeight="0dp"
                                    android:text="Send OTP"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/dark_text"
                                    app:backgroundTint="@color/peach_accent"
                                    app:cornerRadius="17dp"
                                    android:paddingHorizontal="14dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp" />
                            </LinearLayout>

                            <!-- OTP Input and Verify Row -->
                            <LinearLayout
                                android:id="@+id/layoutOtpInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="10dp">

                                <EditText
                                    android:id="@+id/etProfileOtp"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="10dp"
                                    android:background="@drawable/bg_search_pill"
                                    android:backgroundTint="@color/card_bg"
                                    android:hint="6-digit OTP"
                                    android:textColorHint="@color/light_text_muted"
                                    android:gravity="center"
                                    android:inputType="number"
                                    android:maxLength="6"
                                    android:paddingHorizontal="12dp"
                                    android:textColor="@color/peach_accent"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnVerifyProfileOtp"
                                    style="@style/Widget.BorrowBox.Button.Peach"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:minHeight="0dp"
                                    android:text="Verify"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/dark_text"
                                    app:backgroundTint="@color/peach_accent"
                                    app:cornerRadius="20dp"
                                    android:paddingHorizontal="14dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp" />
                            </LinearLayout>

                            <!-- Status/Error Text -->
                            <TextView
                                android:id="@+id/tvProfileOtpStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textSize="11sp"
                                android:visibility="gone" />

                            <!-- Verified Success Banner Container -->
                            <LinearLayout
                                android:id="@+id/layoutOtpVerified"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:visibility="gone"
                                android:layout_marginTop="4dp">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_verified"
                                    app:tint="@color/peach_accent" />

                                <TextView
                                    android:id="@+id/tvOtpVerifiedLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Institutional email verified ✓"
                                    android:textColor="@color/peach_accent"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= Group 3: Actions ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="Actions"
                android:textColor="@color/peach_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Student ID Verification Button (Smaller: height 44dp, smaller text, rounded corners) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStudentVerification"
                        style="@style/Widget.BorrowBox.Button.Peach"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="🎓  Student ID Verification"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        app:backgroundTint="@color/peach_accent"
                        app:cornerRadius="22dp" />

                    <!-- Admin Dashboard (Only visible for admin role) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdminDashboard"
                        style="@style/Widget.BorrowBox.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginTop="10dp"
                        android:text="🛡️  Admin Dashboard"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="22dp"
                        android:visibility="gone" />

                    <!-- My Rentals Button (Smaller: height 44dp, smaller text, rounded corners) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMyRentals"
                        style="@style/Widget.BorrowBox.Button.Purple"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginTop="10dp"
                        android:text="📦  My Rentals &amp; Requests"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="22dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= Log Out Button ================= -->
            <!-- Clearly separated at the bottom, in subtle red/outlined style -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogOut"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:text="Log Out"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/pink_supporting"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/pink_supporting"
                app:strokeWidth="1.5dp"
                app:cornerRadius="22dp"
                app:rippleColor="#33F1A9A9" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ======= Bottom Navigation Bar with Center Cradle ======= -->
    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:fabCradleMargin="8dp"
        app:fabCradleRoundedCornerRadius="20dp"
        app:fabAlignmentMode="center"
        app:backgroundTint="@color/card_bg"
        app:elevation="8dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />

    </com.google.android.material.bottomappbar.BottomAppBar>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Add Item"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/peach_accent"
        app:tint="@color/dark_text"
        app:elevation="6dp"
        app:layout_anchor="@id/bottomAppBar" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
