<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="24dp">

    <ImageView
        android:id="@+id/ivVerifStatusIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_verified"
        android:contentDescription="Status"
        app:tint="@color/peach_accent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvVerifStatusTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.3" />

    <TextView
        android:id="@+id/tvVerifStatusTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Verification Submitted"
        android:textColor="@color/light_text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivVerifStatusIcon"
        app:layout_constraintBottom_toTopOf="@id/tvVerifStatusBadge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvVerifStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Pending Review"
        android:textColor="@color/dark_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/bg_status_available"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        app:layout_constraintTop_toBottomOf="@id/tvVerifStatusTitle"
        app:layout_constraintBottom_toTopOf="@id/tvVerifStatusBody"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvVerifStatusBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Your Student ID has been submitted for admin review.\nYou will see a ✓ Verified badge on your profile once approved."
        android:textColor="@color/light_text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        app:layout_constraintTop_toBottomOf="@id/tvVerifStatusBadge"
        app:layout_constraintBottom_toTopOf="@id/btnVerifStatusDone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerifStatusDone"
        style="@style/Widget.BorrowBox.Button.Peach"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Back to Home"
        app:layout_constraintTop_toBottomOf="@id/tvVerifStatusBody"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
