<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fitsSystemWindows="false">

    <!-- ======= FIXED TOP AREA: Header + Search Pill + Verification Banner ======= -->
    <LinearLayout
        android:id="@+id/fixedTopContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="8dp"
        android:background="@drawable/bg_home_header"
        android:paddingBottom="12dp">

        <!-- Home Header Panel: Redesigned Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/homeHeaderPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">

            <!-- Line 1: Welcome Greeting (Single line, large & bold, auto-shrinks/ellipsizes) -->
            <TextView
                android:id="@+id/tvWelcomeGreeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Welcome, KUETian! ✨"
                android:textColor="@color/light_text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.01"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="18sp"
                app:autoSizeMaxTextSize="28sp"
                app:autoSizeStepGranularity="1sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Line 2 Left: Roll Number Badge -->
            <LinearLayout
                android:id="@+id/headerBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_status_available"
                android:backgroundTint="@color/card_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvWelcomeGreeting"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/ivUserRollIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_box"
                    android:contentDescription="Status icon"
                    app:tint="@color/peach_accent" />

                <TextView
                    android:id="@+id/tvUserStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="KUET Student"
                    android:textColor="@color/peach_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Line 2 Right: User Avatar + Bell Icon -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUserAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="19dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/peach_accent"
                app:cardBackgroundColor="@color/card_bg"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toStartOf="@id/layoutBellIcon"
                app:layout_constraintTop_toTopOf="@id/headerBadge"
                app:layout_constraintBottom_toBottomOf="@id/headerBadge">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivUserAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="User Avatar"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvAvatarInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="U"
                        android:textColor="@color/peach_accent"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Custom Bell Icon with Red Badge (>= 48dp touch target) -->
            <FrameLayout
                android:id="@+id/layoutBellIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/headerBadge"
                app:layout_constraintBottom_toBottomOf="@id/headerBadge">

                <!-- Subtle circular tinted background -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_bell_circle">

                    <!-- Custom rounded bell vector icon -->
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell_rounded"
                        android:contentDescription="Notifications"
                        app:tint="@color/peach_accent" />
                </FrameLayout>

                <!-- Solid red notification badge with border -->
                <TextView
                    android:id="@+id/tvNotifBadge"
                    android:layout_width="wrap_content"
                    android:minWidth="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_notification_badge"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Static Search Pill (tappable, opens SearchActivity) (TASK 1) -->
        <LinearLayout
            android:id="@+id/cardSearchBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Small Rounded Peach Search Icon -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="34dp"
                android:layout_height="34dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/peach_accent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Search"
                    app:tint="@color/dark_text" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Hint text: fits without truncation (TASK 1) -->
            <TextView
                android:id="@+id/tvSearchHint"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:gravity="center_vertical"
                android:text="Search products or tools..."
                android:textColor="@color/light_text_muted"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Item count pill: distinct, nicely spaced, no overlap (TASK 1) -->
            <TextView
                android:id="@+id/tvItemCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@color/card_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="6 items"
                android:textColor="@color/peach_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Unverified Student Warning Banner (TASK 6) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVerificationBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_bg"
            app:strokeColor="@color/pink_supporting"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Verify email to unlock renting."
                    android:textColor="@color/pink_supporting"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnBannerVerify"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verify Now →"
                    android:textColor="@color/peach_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- ======= Scrollable Product List (TASK 2) ======= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewProducts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="150dp"
        android:paddingBottom="100dp"
        android:overScrollMode="never" />

    <!-- ======= Bottom Navigation Bar with Center Cradle for + FAB (TASK 2) ======= -->
    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:fabCradleMargin="8dp"
        app:fabCradleRoundedCornerRadius="20dp"
        app:fabAlignmentMode="center"
        app:backgroundTint="@color/card_bg"
        app:elevation="8dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />

    </com.google.android.material.bottomappbar.BottomAppBar>

    <!-- Visually Distinct Central + Button (Peach with Dark Navy Icon) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Add Item"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/peach_accent"
        app:tint="@color/dark_text"
        app:elevation="6dp"
        app:layout_anchor="@id/bottomAppBar" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
