<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/authRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fitsSystemWindows="false">

    <ScrollView
        android:id="@+id/authScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/authContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="36dp">

            <!-- Logo & Brand Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/ivAuthLogo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_borrowbox_logo"
                    android:contentDescription="BorrowBox"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tvAuthBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="BorrowBox"
                    android:textColor="@color/peach_accent"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="KUET Campus Rental Platform"
                    android:textColor="@color/pink_supporting"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Server Connection Warning Banner (Step 1.8) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardServerBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2D1A25"
                app:strokeColor="#FF6B6B"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvServerBannerMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cannot reach server at http://..."
                        android:textColor="#FF8E8E"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvServerBannerHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Ensure your PC backend is running and both devices share Wi-Fi."
                        android:textColor="#D8C2CB"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBannerChangeUrl"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Change Server URL"
                            android:textColor="@color/peach_accent"
                            android:textSize="12sp"
                            android:paddingHorizontal="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBannerRetry"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:text="Retry"
                            android:textColor="@color/peach_accent"
                            app:strokeColor="@color/peach_accent"
                            android:textSize="12sp"
                            android:paddingHorizontal="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Modern Segmented Toggle Bar: Log In / Register -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardToggleBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabLogin"
                        style="@style/Widget.BorrowBox.Button.Peach"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Log In"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:cornerRadius="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabRegister"
                        style="@style/Widget.BorrowBox.Button.Text"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Register"
                        android:textColor="@color/light_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:cornerRadius="20dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Form Card (Medium Purple #48426D with soft border) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAuthForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Loading Indicator -->
                    <ProgressBar
                        android:id="@+id/authProgressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"
                        android:indeterminateTint="@color/peach_accent" />

                    <!-- ================= LOGIN FORM CONTAINER ================= -->
                    <LinearLayout
                        android:id="@+id/loginFormContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Welcome Back"
                            android:textColor="@color/light_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="16dp"
                            android:text="Sign in with your KUET roll number or student email"
                            android:textColor="@color/light_text_secondary"
                            android:textSize="12sp" />

                        <!-- Login Identifier (Roll or Email) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilLoginIdentifier"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="KUET Email or Roll Number (e.g. 2307108)"
                            app:boxBackgroundColor="@color/input_bg_dark"
                            app:boxStrokeColor="@color/card_border"
                            app:hintTextColor="@color/light_text_secondary"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etLoginIdentifier"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/light_text_primary"
                                android:inputType="textEmailAddress"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Login Password -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilLoginPassword"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="Password"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="@color/peach_accent"
                            app:boxBackgroundColor="@color/input_bg_dark"
                            app:boxStrokeColor="@color/card_border"
                            app:hintTextColor="@color/light_text_secondary"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etLoginPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/light_text_primary"
                                android:inputType="textPassword"
                                android:imeOptions="actionDone" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Submit Login Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitLogin"
                            style="@style/Widget.BorrowBox.Button.Peach"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="20dp"
                            android:text="Log In"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- ================= REGISTER FORM CONTAINER ================= -->
                    <LinearLayout
                        android:id="@+id/registerFormContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KUET Student Registration"
                            android:textColor="@color/light_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="16dp"
                            android:text="Exclusive to verified KUET students. One account per roll number."
                            android:textColor="@color/light_text_secondary"
                            android:textSize="12sp" />

                        <!-- Full Name -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilRegFullName"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Full Name"
                            app:boxBackgroundColor="@color/input_bg_dark"
                            app:boxStrokeColor="@color/card_border"
                            app:hintTextColor="@color/light_text_secondary"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRegFullName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/light_text_primary"
                                android:inputType="textPersonName"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- KUET Roll Number -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilRegRoll"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="KUET Roll Number (e.g. 2307108)"
                            app:helperText="7 digits: batch(2) + dept(2) + serial(3)"
                            app:helperTextTextColor="@color/light_text_muted"
                            app:boxBackgroundColor="@color/input_bg_dark"
                            app:boxStrokeColor="@color/card_border"
                            app:hintTextColor="@color/light_text_secondary"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRegRoll"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/light_text_primary"
                                android:inputType="number"
                                android:maxLength="7"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- KUET Email -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilRegEmail"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="KUET Email (e.g. 2307108@stud.kuet.ac.bd)"
                            app:boxBackgroundColor="@color/input_bg_dark"
                            app:boxStrokeColor="@color/card_border"
                            app:hintTextColor="@color/light_text_secondary"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRegEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/light_text_primary"
                                android:inputType="textEmailAddress"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Phone Number -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilRegPhone"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="Phone Number (e.g. 01700000001)"
                            app:boxBackgroundColor="@color/input_bg_dark"
                            app:boxStrokeColor="@color/card_border"
                            app:hintTextColor="@color/light_text_secondary"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRegPhone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/light_text_primary"
                                android:inputType="phone"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Department -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilRegDept"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="Department (e.g. CSE, EEE, ME, CE)"
                            app:boxBackgroundColor="@color/input_bg_dark"
                            app:boxStrokeColor="@color/card_border"
                            app:hintTextColor="@color/light_text_secondary"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRegDept"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/light_text_primary"
                                android:inputType="text"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Residential Hall -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilRegHall"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="Hall (e.g. Amar Ekushey Hall, Fazlul Haque Hall)"
                            app:boxBackgroundColor="@color/input_bg_dark"
                            app:boxStrokeColor="@color/card_border"
                            app:hintTextColor="@color/light_text_secondary"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRegHall"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/light_text_primary"
                                android:inputType="text"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Password -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilRegPassword"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="Password (min 6 chars)"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="@color/peach_accent"
                            app:boxBackgroundColor="@color/input_bg_dark"
                            app:boxStrokeColor="@color/card_border"
                            app:hintTextColor="@color/light_text_secondary"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRegPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/light_text_primary"
                                android:inputType="textPassword"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Confirm Password -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilRegConfirmPassword"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="Confirm Password"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="@color/peach_accent"
                            app:boxBackgroundColor="@color/input_bg_dark"
                            app:boxStrokeColor="@color/card_border"
                            app:hintTextColor="@color/light_text_secondary"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRegConfirmPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/light_text_primary"
                                android:inputType="textPassword"
                                android:imeOptions="actionDone" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Submit Register Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitRegister"
                            style="@style/Widget.BorrowBox.Button.Peach"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="20dp"
                            android:text="Create Account &amp; Verify →"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Guest Link -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAuthGuest"
                style="@style/Widget.BorrowBox.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:text="Browse as Guest →"
                android:textColor="@color/peach_accent"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
