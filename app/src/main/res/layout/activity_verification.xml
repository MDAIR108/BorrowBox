<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/verificationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fitsSystemWindows="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/verificationContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="36dp">

            <!-- Toolbar with Back Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnVerifBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_border"
                    app:cardBackgroundColor="@color/card_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="←"
                        android:textColor="@color/peach_accent"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Student Verification"
                    android:textColor="@color/light_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Verification Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp"
                    android:gravity="center_horizontal">

                    <!-- Icon -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/card_border"
                        app:cardBackgroundColor="@color/input_bg_dark">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_verified"
                            android:contentDescription="Verification"
                            app:tint="@color/peach_accent" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvVerifTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Enter Verification Code"
                        android:textColor="@color/light_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVerifSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="We sent a 6-digit verification code to your registered KUET student email:"
                        android:textColor="@color/light_text_secondary"
                        android:textSize="13sp"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvTargetEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="student@stud.kuet.ac.bd"
                        android:textColor="@color/peach_accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- 6-Box OTP Code Input Row (TASK 6) -->
                    <LinearLayout
                        android:id="@+id/otpBoxContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="24dp">

                        <EditText
                            android:id="@+id/etOtp1"
                            android:layout_width="44dp"
                            android:layout_height="52dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_search_pill"
                            android:backgroundTint="@color/input_bg_dark"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/peach_accent"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etOtp2"
                            android:layout_width="44dp"
                            android:layout_height="52dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_search_pill"
                            android:backgroundTint="@color/input_bg_dark"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/peach_accent"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etOtp3"
                            android:layout_width="44dp"
                            android:layout_height="52dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_search_pill"
                            android:backgroundTint="@color/input_bg_dark"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/peach_accent"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etOtp4"
                            android:layout_width="44dp"
                            android:layout_height="52dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_search_pill"
                            android:backgroundTint="@color/input_bg_dark"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/peach_accent"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etOtp5"
                            android:layout_width="44dp"
                            android:layout_height="52dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_search_pill"
                            android:backgroundTint="@color/input_bg_dark"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/peach_accent"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etOtp6"
                            android:layout_width="44dp"
                            android:layout_height="52dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_search_pill"
                            android:backgroundTint="@color/input_bg_dark"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/peach_accent"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Error State Message Container -->
                    <TextView
                        android:id="@+id/tvOtpError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="Incorrect code. 4 attempts remaining."
                        android:textColor="@color/pink_supporting"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Progress Bar -->
                    <ProgressBar
                        android:id="@+id/otpProgressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        android:indeterminateTint="@color/peach_accent" />

                    <!-- Verify Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerifyCode"
                        style="@style/Widget.BorrowBox.Button.Peach"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp"
                        android:text="Verify &amp; Unlock Rentals"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Resend Button with 60-Second Countdown -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResendCode"
                        style="@style/Widget.BorrowBox.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:text="Resend code in 60s"
                        android:textColor="@color/light_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Verification Perks Note -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Why is verification required?"
                        android:textColor="@color/light_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="• Verified status prevents fake accounts\n• Protects borrowed tools, books and calculators\n• Unlocks one-click campus rental requests"
                        android:textColor="@color/light_text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
