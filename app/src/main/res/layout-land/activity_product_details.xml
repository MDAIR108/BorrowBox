<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Toolbar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/detailsToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <!-- Rounded square back button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnDetailsBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_bg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="←"
                    android:textColor="@color/peach_accent"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product Details"
                android:textColor="@color/light_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Share button in toolbar (Implicit Intent) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnShareProduct"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="↗"
                    android:textColor="@color/peach_accent"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Loading Spinner -->
        <ProgressBar
            android:id="@+id/detailsProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:indeterminateTint="@color/peach_accent" />

        <!-- Scrollable Body with generous bottom padding -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/detailsScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/detailsContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="120dp">

                <!-- 1. Large Hero Product Photo (top, rounded corners, tap-to-zoom) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProductPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_border"
                    app:cardBackgroundColor="@color/input_bg_dark"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivProductPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:contentDescription="Product photo" />

                        <TextView
                            android:id="@+id/tvLargeProductEmoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="📦"
                            android:textSize="58sp" />

                        <TextView
                            android:id="@+id/tvTapToZoomHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="12dp"
                            android:background="#AA000000"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:text="🔍 Tap to zoom"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Product Name, Price & Badges Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_border"
                    app:cardBackgroundColor="@color/card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/tvProductTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Product Name"
                            android:textColor="@color/light_text_primary"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <!-- Price Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:id="@+id/tvProductPriceBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="৳20 / day"
                                android:textColor="@color/peach_accent"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvProductStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_available"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="Available"
                                android:textColor="@color/dark_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Chips Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:id="@+id/tvProductCategoryBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_chip"
                                android:backgroundTint="@color/input_bg_dark"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="5dp"
                                android:text="Tools"
                                android:textColor="@color/light_text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvProductConditionBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_chip"
                                android:backgroundTint="@color/input_bg_dark"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="5dp"
                                android:text="Good condition"
                                android:textColor="@color/peach_accent"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Details Section Card (model, max rent days, location) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_border"
                    app:cardBackgroundColor="@color/card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Details"
                            android:textColor="@color/peach_accent"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Model Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:text="Model / Type"
                                android:textColor="@color/light_text_muted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvProductModel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Standard"
                                android:textColor="@color/light_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Max Rent Days Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:text="Max Duration"
                                android:textColor="@color/light_text_muted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvProductMaxDays"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Up to 7 days"
                                android:textColor="@color/light_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Campus Location Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:text="Location"
                                android:textColor="@color/light_text_muted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvLocationDetails"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="KUET Campus"
                                android:textColor="@color/light_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Description Section Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_border"
                    app:cardBackgroundColor="@color/card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Description"
                            android:textColor="@color/peach_accent"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProductDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Product description"
                            android:textColor="@color/light_text_secondary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Features Section Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFeatures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_border"
                    app:cardBackgroundColor="@color/card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Features"
                            android:textColor="@color/peach_accent"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProductFeatures"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="• Genuine product\n• Good working condition"
                            android:textColor="@color/light_text_primary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="5dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 6. Owner Section Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOwnerSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_border"
                    app:cardBackgroundColor="@color/card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Owner"
                            android:textColor="@color/peach_accent"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Owner info row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                app:cardCornerRadius="24dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="@color/peach_ring"
                                app:cardBackgroundColor="@color/input_bg_dark">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="👤"
                                    android:textSize="22sp" />
                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvOwnerName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="KUET Member"
                                    android:textColor="@color/light_text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvOwnerRollDept"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="KUET Department"
                                    android:textColor="@color/light_text_secondary"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvOwnerHall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Hall Location"
                                    android:textColor="@color/light_text_muted"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvOwnerVerifiedBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_available"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="✓ Verified"
                                android:textColor="@color/dark_text"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Owner Contact / Actions -->
                        <LinearLayout
                            android:id="@+id/ownerContactContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:id="@+id/tvOwnerPhone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="📞 Phone: Available"
                                android:textColor="@color/light_text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvOwnerEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="✉️ Email: Verified student"
                                android:textColor="@color/peach_accent"
                                android:textSize="13sp" />

                            <!-- Call / Message Actions -->
                            <LinearLayout
                                android:id="@+id/ownerActionButtons"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="12dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCallOwner"
                                    style="@style/Widget.BorrowBox.Button.Peach"
                                    android:layout_width="0dp"
                                    android:layout_height="42dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="6dp"
                                    android:text="Call Owner"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnMessageOwner"
                                    style="@style/Widget.BorrowBox.Button.Outlined"
                                    android:layout_width="0dp"
                                    android:layout_height="42dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="6dp"
                                    android:text="Message / SMS"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Guest Prompt if Guest -->
                        <LinearLayout
                            android:id="@+id/guestMaskPrompt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="10dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="🔒 Owner contact details and direct messaging are reserved for verified students."
                                android:textColor="@color/pink_supporting"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnGuestLoginPrompt"
                                style="@style/Widget.BorrowBox.Button.Outlined"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="8dp"
                                android:text="Log In to View Contact Info"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 7. Rent This Item Card with Date Pickers & Actions -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_border"
                    app:cardBackgroundColor="@color/card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rent This Item"
                            android:textColor="@color/light_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Date Selection Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="14dp">

                            <!-- Pickup Date -->
                            <LinearLayout
                                android:id="@+id/btnPickStartDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_search_pill"
                                android:backgroundTint="@color/input_bg_dark"
                                android:orientation="vertical"
                                android:padding="12dp"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pickup Date"
                                    android:textColor="@color/light_text_muted"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvDetailStartDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Today"
                                    android:textColor="@color/light_text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Return Date -->
                            <LinearLayout
                                android:id="@+id/btnPickReturnDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_search_pill"
                                android:backgroundTint="@color/input_bg_dark"
                                android:orientation="vertical"
                                android:padding="12dp"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Return Date"
                                    android:textColor="@color/light_text_muted"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvDetailReturnDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Tomorrow"
                                    android:textColor="@color/light_text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Duration & Total Cost -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="14dp">

                            <TextView
                                android:id="@+id/tvDetailDuration"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Duration: 1 day"
                                android:textColor="@color/light_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvDetailTotalCost"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total: ৳20"
                                android:textColor="@color/peach_accent"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Blocked Notice Banner -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardRentBlockedNotice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:visibility="gone"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/pink_supporting"
                            app:cardBackgroundColor="@color/input_bg_dark">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvRentBlockedReason"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="⚠️ You must be a verified student to rent items."
                                    android:textColor="@color/pink_supporting"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnGoToVerificationFromDetails"
                                    style="@style/Widget.BorrowBox.Button.Peach"
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:layout_marginTop="8dp"
                                    android:text="Verify KUET Student Email →"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Action Buttons: Submit Rental Request & WhatsApp Chat -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitRent"
                            style="@style/Widget.BorrowBox.Button.Peach"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="16dp"
                            android:text="Submit Rental Request"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_text"
                            app:backgroundTint="@color/peach_accent"
                            app:cornerRadius="25dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWhatsApp"
                            style="@style/Widget.BorrowBox.Button.Peach"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="10dp"
                            android:text="Chat on WhatsApp"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_text"
                            app:backgroundTint="@color/peach_accent"
                            app:icon="@drawable/ic_whatsapp"
                            app:iconTint="@color/dark_text"
                            app:iconGravity="textStart"
                            app:cornerRadius="25dp"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
