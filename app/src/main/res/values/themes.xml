<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BorrowBox" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">#231F3B</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/accent</item>

        <!-- Status Bar & Background -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- Rounded Components by default -->
        <item name="cardViewStyle">@style/Widget.BorrowBox.CardView</item>
        <item name="materialButtonStyle">@style/Widget.BorrowBox.Button</item>
    </style>

    <!-- Shape Appearances for Rounded Corners Everywhere -->
    <style name="ShapeAppearance.BorrowBox.RoundedCard" parent="">
        <item name="cornerSize">16dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="ShapeAppearance.BorrowBox.Pill" parent="">
        <item name="cornerSize">24dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="ShapeAppearance.BorrowBox.Medium" parent="">
        <item name="cornerSize">14dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="ShapeAppearance.BorrowBox.Small" parent="">
        <item name="cornerSize">8dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <!-- Default CardView Style -->
    <style name="Widget.BorrowBox.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BorrowBox.RoundedCard</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border_color</item>
    </style>

    <!-- Primary Rounded Button -->
    <style name="Widget.BorrowBox.Button" parent="Widget.MaterialComponents.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BorrowBox.Pill</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Accent Button Style -->
    <style name="Widget.BorrowBox.Button.Accent" parent="Widget.BorrowBox.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Outlined Button Style -->
    <style name="Widget.BorrowBox.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BorrowBox.Pill</item>
        <item name="strokeColor">@color/secondary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Text-Only Button Style -->
    <style name="Widget.BorrowBox.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BorrowBox.Pill</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
