# ─────────────────────────────────────────────────────────────────────────────
# BorrowBox Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5050
NODE_ENV=development        # change to "production" on the server

# ── MySQL Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=borrowbox

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── SMTP / Email  ─────────────────────────────────────────────────────────────
# ┌─ Gmail (recommended for quick setup) ──────────────────────────────────────┐
# │  1. Enable 2-Step Verification on your Google account.                     │
# │  2. Go to Google Account → Security → 2-Step Verification → App passwords. │
# │  3. Create an App password for "Mail / Windows Computer" (or any name).    │
# │  4. Use that 16-character App Password as SMTP_PASS (not your real pass).  │
# └────────────────────────────────────────────────────────────────────────────┘
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true            # true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="BorrowBox KUET" <your.email@gmail.com>

# ┌─ Alternatives ─────────────────────────────────────────────────────────────┐
# │  Brevo (formerly Sendinblue) — generous free tier, no KUET email needed:   │
# │    SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURE=false        │
# │    SMTP_USER=<brevo_login_email>   SMTP_PASS=<brevo_smtp_key>              │
# │                                                                             │
# │  Resend — developer-friendly, 3,000 free emails/month:                     │
# │    SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true              │
# │    SMTP_USER=resend           SMTP_PASS=<resend_api_key>                   │
# └────────────────────────────────────────────────────────────────────────────┘
